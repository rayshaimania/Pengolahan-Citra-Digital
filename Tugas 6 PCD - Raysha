{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyPvJ0PXjYZtdi93ZwCcWi2r"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":2,"metadata":{"id":"FPh7500pqzOj","executionInfo":{"status":"ok","timestamp":1793344725465,"user_tz":-420,"elapsed":7647,"user":{"displayName":"RAYSHA IMANIA SISWANDI","userId":"11698413558660921431"}}},"outputs":[],"source":["import cv2\n","import numpy as np\n","import matplotlib.pyplot as plt\n","\n","# 1. Baca gambar (file sudah ada di panel Files Colab)\n","img = cv2.imread(\"sayangku.jpg\")\n","assert img is not None, \"Gambar tidak ditemukan. Pastikan sayangku.jpg ada di /content\"\n","img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n","h, w = img.shape[:2]\n","\n","# 2. Translation\n","tx, ty = 300, 150\n","translated = cv2.warpAffine(img, np.float32([[1, 0, tx], [0, 1, ty]]), (w, h))\n","\n","# 3. Scaling\n","scaled_05 = cv2.resize(img, None, fx=0.5, fy=0.5, interpolation=cv2.INTER_AREA)\n","scaled_2  = cv2.resize(img, None, fx=2.0, fy=2.0, interpolation=cv2.INTER_CUBIC)\n","\n","# 4. Rotation\n","def rotate(image, angle):\n","    h, w = image.shape[:2]\n","    c = (w / 2, h / 2)\n","    M = cv2.getRotationMatrix2D(c, angle, 1.0)\n","    cos, sin = abs(M[0, 0]), abs(M[0, 1])\n","    nw, nh = int(h * sin + w * cos), int(h * cos + w * sin)\n","    M[0, 2] += nw / 2 - c[0]\n","    M[1, 2] += nh / 2 - c[1]\n","    return cv2.warpAffine(image, M, (nw, nh))\n","\n","# 5. Flip + 6. Tampilkan semua\n","results = [\n","    (\"Citra Asli\", img),\n","    (f\"Translation (tx={tx}, ty={ty})\", translated),\n","    (\"Scaling 0,5x\", scaled_05),\n","    (\"Scaling 2x\", scaled_2),\n","    (\"Rotation 45°\", rotate(img, 45)),\n","    (\"Rotation 90°\", rotate(img, 90)),\n","    (\"Rotation 180°\", rotate(img, 180)),\n","    (\"Horizontal Flip\", cv2.flip(img, 1)),\n","    (\"Vertical Flip\", cv2.flip(img, 0)),\n","]\n","\n","plt.figure(figsize=(15, 11))\n","for i, (t, im) in enumerate(results, 1):\n","    plt.subplot(3, 3, i)\n","    plt.imshow(im)\n","    plt.title(f\"{t}\\n{im.shape[1]}x{im.shape[0]} px\", fontsize=10)\n","    plt.axis(\"off\")\n","plt.tight_layout()\n","plt.savefig(\"hasil_transformasi.png\", dpi=130)\n","plt.show()"]},{"cell_type":"code","source":[],"metadata":{"id":"bdnni4-MrMKP"},"execution_count":null,"outputs":[]}]}